{
	"groups": {
		"group:workshop-team": [
			"TEAMMATE_LOGIN",
		],
	},

	"tagOwners": {
		"tag:ci-deployer":     ["autogroup:admin"],
		"tag:ci-agent":        ["autogroup:admin"],
		"tag:workshop-app":    ["autogroup:admin"],
		"tag:border0-managed": ["autogroup:admin"],
		"tag:aperture":        ["autogroup:admin"],
	},

	"autoApprovers": {
		"services": {
			"svc:workshop-app":    ["tag:workshop-app"],
			"tag:border0-managed": ["tag:border0-managed"],
		},
	},

	"grants": [
		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:self"],
			"ip":  ["*"],
		},
		{
			"src": ["AUTHOR_LOGIN"],
			"dst": ["svc:workshop-app", "tag:workshop-app"],
			"ip":  ["tcp:443"],
		},
		{
			"src": ["AUTHOR_LOGIN", "tag:ci-deployer"],
			"dst": ["svc:kb-gke-dev"],
			"ip":  ["*"],
			"app": {
				"tailscale.com/cap/pam": [{
					"version": "v1",
					"permissions": {
						"kubernetes": {
							"rules": [{
								"api_groups": ["*"],
								"namespaces": ["dev-kartik"],
								"resources":  ["*"],
								"verbs":      ["*"],
							}],
						},
					},
				}],
			},
		},
		{
			"src": ["AUTHOR_LOGIN", "tag:ci-agent"],
			"dst": ["tag:aperture"],
			"ip":  ["tcp:80"],
			"app": {
				"tailscale.com/cap/aperture": [
					{"role": "user"},
					{"models": "**"},
				],
			},
		},
	],

	"tests": [
		{
			"src":    "AUTHOR_LOGIN",
			"accept": ["svc:workshop-app:443"],
		},
		{
			"src":  "TEAMMATE_LOGIN",
			"deny": ["svc:workshop-app:443"],
		},
		{
			"src":  "tag:ci-deployer",
			"deny": ["svc:workshop-app:443", "tag:workshop-app:443"],
		},
	],
}
